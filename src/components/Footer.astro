---
const productLinks = [
  { label: 'Pricing',   href: '/pricing'   },
  { label: 'Changelog', href: '/changelog' },
  { label: 'Status',    href: 'https://status.nodalpulse.com', external: true },
  { label: 'Sources',   href: '/sources'   },
  { label: 'Log in',    href: 'https://app.nodalpulse.com/login', external: true },
];

const legalLinks = [
  { label: 'Security', href: '/security' },
  { label: 'Privacy',  href: '/privacy'  },
  { label: 'Terms',    href: '/terms'    },
];
---

<footer class="footer-wrapper">
  <div class="container footer-inner">
    <div class="footer-grid">
      <!-- Left: logo + tagline -->
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="NodalPulse home">
          <svg width="148" height="24" viewBox="0 0 148 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect x="0" y="6" width="12" height="12" rx="2" fill="#6366F1"/>
            <text x="20" y="18" font-family="Inter, -apple-system, system-ui, sans-serif" font-size="15" font-weight="600" fill="#18181B" letter-spacing="-0.01em">NodalPulse</text>
          </svg>
        </a>
        <p class="footer-tagline">
          Regulatory intelligence for ERCOT market participants. Personalized. Cited. On time.
        </p>
      </div>

      <!-- Right: links grid -->
      <div class="footer-links-grid">
        <div class="footer-col">
          <h3 class="footer-col-heading">Product</h3>
          <ul>
            {productLinks.map(link => (
              <li><a href={link.href} class="footer-link" target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}</a></li>
            ))}
          </ul>
        </div>
        <div class="footer-col">
          <h3 class="footer-col-heading">Legal</h3>
          <ul>
            {legalLinks.map(link => (
              <li><a href={link.href} class="footer-link">{link.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="footer-copyright">
        &copy; 2026 NodalPulse. Built for ERCOT participants.
      </span>
    </div>
  </div>
</footer>

<style>
  .footer-wrapper {
    border-top: 1px solid var(--np-border);
    background: var(--np-surface);
  }

  .footer-inner {
    padding-top: 48px;
    padding-bottom: 32px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 64px;
    align-items: start;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 320px;
  }

  .footer-logo {
    display: inline-flex;
  }

  .footer-tagline {
    font-size: 13px;
    color: var(--np-text-muted);
    line-height: 1.6;
  }

  .footer-links-grid {
    display: flex;
    gap: 48px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-col-heading {
    font-size: 12px;
    font-weight: 600;
    color: var(--np-text-strong);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .footer-link {
    font-size: 13px;
    color: var(--np-text-muted);
    text-decoration: none;
    transition: color 0.12s ease;
  }

  .footer-link:hover {
    color: var(--np-text-primary);
  }

  .footer-bottom {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--np-border);
  }

  .footer-copyright {
    font-size: 12px;
    color: var(--np-text-muted);
  }
</style>
