---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('help', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const categoryLabels: Record<string, string> = {
  'getting-started': 'Getting Started',
  'features': 'Features',
  'account': 'Account',
  'reference': 'Reference',
};
---

<Base
  title="Help Center — NodalPulse"
  description="Guides for NodalPulse: how briefs work, deadlines, Ask the Record, coverage, account and billing."
>

  <!-- ── Hero ── -->
  <section class="hero section-sm">
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-heading">Help Center</h1>
        <p class="hero-sub">
          Guides for getting the most out of NodalPulse.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Articles list ── -->
  <section class="articles-section section">
    <div class="container">
      {articles.length === 0 ? (
        <p class="empty-note">No articles published yet — check back soon.</p>
      ) : (
        <div class="articles-list">
          {articles.map(article => (
            <a href={`/help/${article.slug}`} class="article-row">
              <div class="article-row-body">
                <span class="article-category">{categoryLabels[article.data.category]}</span>
                <h2 class="article-title">{article.data.title}</h2>
                <p class="article-desc">{article.data.description}</p>
              </div>
              <span class="article-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- ── Support CTA ── -->
  <section class="support-section section-sm">
    <div class="container">
      <p class="support-note">
        Can't find what you're looking for? Email <a href="mailto:hello@nodalpulse.com" class="support-link">hello@nodalpulse.com</a> — we respond within one business day.
      </p>
    </div>
  </section>

</Base>

<style>
  /* ── Hero ── */
  .hero {
    border-bottom: 1px solid var(--np-border);
    background: var(--np-surface-elevated);
  }

  .hero-content {
    max-width: 640px;
  }

  .hero-heading {
    font-size: clamp(26px, 3.5vw, 36px);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--np-text-primary);
    margin-bottom: 10px;
  }

  .hero-sub {
    font-size: 16px;
    color: var(--np-text-muted);
    line-height: 1.7;
  }

  /* ── Articles list ── */
  .articles-section {
    border-bottom: 1px solid var(--np-border);
  }

  .articles-list {
    max-width: 800px;
    border: 1px solid var(--np-border);
    border-radius: var(--np-radius-lg);
    overflow: hidden;
  }

  .article-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 22px 24px;
    border-bottom: 1px solid var(--np-border);
    text-decoration: none;
    transition: background 0.12s ease;
  }

  .article-row:last-child {
    border-bottom: none;
  }

  .article-row:hover {
    background: var(--np-surface-elevated);
  }

  .article-row-body {
    flex: 1;
    min-width: 0;
  }

  .article-category {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--np-text-muted);
    margin-bottom: 6px;
  }

  .article-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--np-text-primary);
    line-height: 1.4;
    margin-bottom: 4px;
  }

  .article-row:hover .article-title {
    color: var(--np-accent);
  }

  .article-desc {
    font-size: 13px;
    color: var(--np-text-muted);
    line-height: 1.6;
  }

  .article-arrow {
    font-size: 16px;
    color: var(--np-text-muted);
    flex-shrink: 0;
    transition: color 0.12s ease, transform 0.12s ease;
  }

  .article-row:hover .article-arrow {
    color: var(--np-accent);
    transform: translateX(2px);
  }

  .empty-note {
    font-size: 14px;
    color: var(--np-text-muted);
  }

  /* ── Support CTA ── */
  .support-note {
    font-size: 14px;
    color: var(--np-text-muted);
  }

  .support-link {
    color: var(--np-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .support-link:hover {
    color: var(--np-accent-hover);
  }
</style>
