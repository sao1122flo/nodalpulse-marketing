---
import Base from '../layouts/Base.astro';

const tiers = [
  { name: 'Starter', price: '$99',   period: '/mo', highlight: false, contactOnly: false, href: 'https://app.nodalpulse.com/login?callbackURL=%2Fpricing%3Ftier%3Dstarter' },
  { name: 'Pro',     price: '$249',  period: '/mo', highlight: true,  contactOnly: false, href: 'https://app.nodalpulse.com/login?callbackURL=%2Fpricing%3Ftier%3Dpro'     },
  { name: 'Team',    price: '$749',  period: '/mo', highlight: false, contactOnly: false, href: 'https://app.nodalpulse.com/login?callbackURL=%2Fpricing%3Ftier%3Dteam'    },
  { name: 'Org',     price: '$1,999',period: '/mo', highlight: false, contactOnly: true,  href: 'mailto:hello@nodalpulse.com'                                              },
];

const rows = [
  { label: 'Tracked dockets',     values: ['5', '25', '100', 'Unlimited'] },
  { label: 'Brief history',       values: ['30 days', '1 year', '3 years', 'Unlimited'] },
  { label: 'Ask the Record',      values: ['10 q/day', '30 q/day', '100 q/day', '300 q/day'] },
  { label: 'Team seats',          values: ['1', '1', '5', '25'] },
  { label: 'Regions included',    values: ['1', '1', '1', 'All'] },
  { label: 'SLA',                 values: ['—', '—', '99.5%', '99.9%'] },
  { label: 'API access',          values: ['—', '—', '—', '✓'] },
];

const faqs = [
  {
    q: 'How does regional pricing work?',
    a: 'Each plan includes one region of your choice — Texas, California, or PJM. Additional regions are +$49/mo (Starter/Pro) or +$99/mo (Team), added in-app after signup. Org includes all regions. There is no published 2D pricing matrix — you pick your region when you start.',
  },
  {
    q: 'Is there a free trial?',
    a: 'Yes. 14 days free on the Pro plan with one region of your choice. No credit card required to start.',
  },
  {
    q: 'Are CAISO (California) and PJM included during Beta?',
    a: 'Yes. Both Beta regions are included at no additional cost with any paid plan during the Beta period. When Beta ends and they become generally available, you\'ll have the option to add them at the standard region add-on price.',
  },
  {
    q: 'How is this different from asking Claude or ChatGPT?',
    a: 'General-purpose AI relies on web search indexes that capture 30–40% of PUCT Interchange and FERC filings at best. NodalPulse runs purpose-built crawlers that hit the source systems directly on submission. Every answer is grounded in extracted filing text with source citations. Claims that cannot be sourced are dropped before delivery. You also get a persistent docket history, deadline extraction, and scheduled 06:00 CT delivery — none of which a chat session provides.',
  },
  {
    q: 'Can I cancel anytime?',
    a: 'Yes. Subscriptions are billed monthly and cancel at any time from your account settings. Cancellation takes effect at the end of the current billing period. No cancellation fees.',
  },
  {
    q: 'What sources are covered?',
    a: 'Texas: PUCT Interchange (all filings), ERCOT stakeholder pages. California (Beta): CAISO filings index + referenced FERC ER/EL dockets. PJM (Beta): FERC eLibrary + Independent Market Monitor + PJM stakeholder/auction calendar. See the Coverage page for full detail and roadmap.',
  },
];
---

<Base
  title="Pricing — NodalPulse"
  description="NodalPulse pricing: Starter $99/mo, Pro $249/mo, Team $749/mo, Org $1,999/mo. One region per plan. 14-day free trial, no card required. CAISO and PJM Beta included at no extra cost."
  extraSchema={[{
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }]}
>

  <section class="section">
    <div class="container">

      <div class="pricing-header">
        <h1 class="page-title">Simple, transparent pricing</h1>
        <p class="page-sub">
          One region per plan. 14-day free trial on Pro — no card required. CAISO and PJM Beta included at no extra cost.
        </p>
      </div>

      <!-- Tier cards row -->
      <div class="tier-cards">
        {tiers.map(tier => (
          <div class:list={['tier-card', { 'tier-card--highlight': tier.highlight }]}>
            {tier.highlight && <div class="tier-badge">Most popular</div>}
            <div class="tier-name">{tier.name}</div>
            <div class="tier-price">
              <span class="tier-amount">{tier.price}</span>
              {tier.period && <span class="tier-period">{tier.period}</span>}
            </div>
            <a
              href={tier.href}
              class:list={[tier.highlight ? 'btn-primary' : 'btn-secondary', 'tier-cta']}
            >
              {tier.contactOnly ? 'Contact us' : 'Start free trial'}
            </a>
          </div>
        ))}
      </div>

      <!-- Region add-on note -->
      <div class="addon-note">
        <span class="addon-icon" aria-hidden="true">+</span>
        <span>
          Additional regions: <strong>+$49/mo</strong> (Starter &amp; Pro) · <strong>+$99/mo</strong> (Team) · <strong>Included</strong> (Org).
          Added in-app after signup — cross-sell happens in the product, not here.
          California (Beta) and PJM (Beta) are included at no extra cost during Beta.
        </span>
      </div>

      <!-- Comparison table -->
      <div class="table-wrapper">
        <table class="compare-table">
          <thead>
            <tr>
              <th class="row-label-header">Feature</th>
              {tiers.map(tier => (
                <th class:list={['col-header', { 'col-header--highlight': tier.highlight }]}>
                  {tier.name}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map(row => (
              <tr>
                <td class="row-label">{row.label}</td>
                {row.values.map((val, i) => (
                  <td class:list={['row-val', { 'row-val--highlight': tiers[i].highlight, 'row-val--empty': val === '—' }]}>
                    {val}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- FAQ -->
      <div class="faq-section">
        <h2 class="faq-heading">Frequently asked questions</h2>
        <div class="faq-list">
          {faqs.map(faq => (
            <details class="faq-item">
              <summary class="faq-question">{faq.q}</summary>
              <div class="faq-answer">{faq.a}</div>
            </details>
          ))}
        </div>
      </div>

      <!-- Bottom CTA -->
      <div class="pricing-cta">
        <a href="https://app.nodalpulse.com/pricing" class="btn-primary btn-lg">
          Start your 14-day free trial &rarr;
        </a>
        <p class="pricing-cta-note">No card required. Pro plan + 1 region of your choice.</p>
      </div>

    </div>
  </section>

</Base>

<style>
  .pricing-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .page-title {
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--np-text-primary);
    margin-bottom: 10px;
  }

  .page-sub {
    font-size: 16px;
    color: var(--np-text-muted);
    max-width: 540px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Tier cards */
  .tier-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--np-border);
    border: 1px solid var(--np-border);
    border-radius: var(--np-radius-lg);
    overflow: hidden;
    margin-bottom: 0;
  }

  .tier-card {
    background: var(--np-surface);
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
  }

  .tier-card--highlight {
    background: var(--np-indigo-50);
  }

  .tier-badge {
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--np-indigo-600);
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 0 0 var(--np-radius-sm) var(--np-radius-sm);
  }

  .tier-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--np-text-strong);
    letter-spacing: 0.02em;
    margin-top: 10px;
  }

  .tier-price {
    display: flex;
    align-items: baseline;
    gap: 3px;
  }

  .tier-amount {
    font-size: 24px;
    font-weight: 600;
    color: var(--np-text-primary);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .tier-period {
    font-size: 13px;
    color: var(--np-text-muted);
  }

  .tier-cta {
    width: 100%;
    justify-content: center;
    font-size: 13px;
    padding: 8px 12px;
    text-align: center;
    display: block;
  }

  /* Region add-on note */
  .addon-note {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 13px;
    color: var(--np-text-muted);
    background: var(--np-surface-elevated);
    border: 1px solid var(--np-border);
    border-top: none;
    border-radius: 0 0 var(--np-radius-lg) var(--np-radius-lg);
    padding: 12px 16px;
    margin-bottom: 32px;
    line-height: 1.6;
  }

  .addon-icon {
    font-size: 15px;
    font-weight: 700;
    color: var(--np-accent);
    flex-shrink: 0;
    margin-top: 1px;
  }

  /* Comparison table */
  .table-wrapper {
    overflow-x: auto;
    margin-bottom: 56px;
    border: 1px solid var(--np-border);
    border-radius: var(--np-radius-lg);
  }

  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .compare-table thead tr {
    background: var(--np-surface-elevated);
    border-bottom: 1px solid var(--np-border-strong);
  }

  .row-label-header {
    text-align: left;
    padding: 12px 20px;
    font-weight: 600;
    color: var(--np-text-strong);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    width: 200px;
  }

  .col-header {
    text-align: center;
    padding: 12px 16px;
    font-weight: 600;
    color: var(--np-text-strong);
    font-size: 13px;
    border-left: 1px solid var(--np-border);
  }

  .col-header--highlight {
    background: var(--np-indigo-50);
    color: var(--np-indigo-700);
  }

  .compare-table tbody tr {
    border-bottom: 1px solid var(--np-border);
  }

  .compare-table tbody tr:last-child {
    border-bottom: none;
  }

  .compare-table tbody tr:hover {
    background: var(--np-surface-elevated);
  }

  .row-label {
    padding: 12px 20px;
    color: var(--np-text-body);
    font-weight: 500;
  }

  .row-val {
    text-align: center;
    padding: 12px 16px;
    color: var(--np-text-primary);
    border-left: 1px solid var(--np-border);
    font-variant-numeric: tabular-nums;
  }

  .row-val--highlight {
    background: color-mix(in srgb, var(--np-indigo-50) 40%, transparent);
  }

  .row-val--empty {
    color: var(--np-text-muted);
  }

  /* FAQ */
  .faq-section {
    max-width: 680px;
    margin: 0 auto 56px;
  }

  .faq-heading {
    font-size: 20px;
    font-weight: 600;
    color: var(--np-text-primary);
    letter-spacing: -0.01em;
    margin-bottom: 24px;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--np-border);
    border-radius: var(--np-radius-lg);
    overflow: hidden;
  }

  .faq-item {
    border-bottom: 1px solid var(--np-border);
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    font-size: 14px;
    font-weight: 500;
    color: var(--np-text-primary);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::after {
    content: '+';
    font-size: 18px;
    font-weight: 400;
    color: var(--np-text-muted);
    flex-shrink: 0;
    margin-left: 16px;
  }

  details[open] .faq-question::after {
    content: '−';
  }

  .faq-question:hover {
    background: var(--np-surface-elevated);
  }

  .faq-answer {
    padding: 0 20px 16px;
    font-size: 14px;
    color: var(--np-text-muted);
    line-height: 1.7;
  }

  /* Bottom CTA */
  .pricing-cta {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .pricing-cta-note {
    font-size: 13px;
    color: var(--np-text-muted);
  }

  .btn-lg {
    padding: 11px 22px;
    font-size: 15px;
  }

  @media (max-width: 768px) {
    .tier-cards { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .tier-cards { grid-template-columns: 1fr; }
  }
</style>
