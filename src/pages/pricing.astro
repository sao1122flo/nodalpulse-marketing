---
import Base from '../layouts/Base.astro';

const tiers = [
  { name: 'Starter', price: '$99',   period: '/mo', dockets: '5',         history: '30 days',   qa: '10/day',  seats: '1',  highlight: false, contactOnly: false,
    tagline: 'One market, one analyst',
    features: ['5 tracked dockets', '30-day brief history', '10 Ask-the-Record Q/day'],
    description: 'Best for an individual covering a single market with moderate tracking needs — focused monitoring without heavy team collaboration.' },
  { name: 'Pro',     price: '$249',  period: '/mo', dockets: '25',        history: '1 year',    qa: '30/day',  seats: '1',  highlight: true,  contactOnly: false,
    tagline: 'Daily coverage for a working practitioner',
    features: ['25 tracked dockets', '1-year brief history', '30 Ask-the-Record Q/day'],
    description: 'The right balance for most regulatory specialists: meaningful docket capacity, a full year of history, and enough query volume for daily use. The plan most serious practitioners and small teams choose.' },
  { name: 'Team',    price: '$749',  period: '/mo', dockets: '100',       history: '3 years',   qa: '100/day', seats: '5',  highlight: false, contactOnly: false,
    tagline: 'A regulatory desk, in sync',
    features: ['100 tracked dockets', '5 team seats', '99.5% uptime SLA'],
    description: 'For groups collaborating across multiple seats — deeper history, higher query volume, and stronger reliability guarantees for active market operations.' },
  { name: 'Org',     price: '$1,999',period: '/mo', dockets: 'Unlimited', history: 'Unlimited', qa: '300/day', seats: '25', highlight: false, contactOnly: true,
    tagline: 'Enterprise, every market',
    features: ['Unlimited dockets, all markets', '25 seats + API access', '99.9% uptime SLA'],
    description: 'For larger organizations needing broad coverage, unlimited scale, enterprise-grade SLAs, and API access for internal systems — significant regulatory exposure across multiple ISO/RTO markets.' },
];

const rows = [
  { label: 'Tracked dockets',  values: ['5', '25', '100', 'Unlimited'] },
  { label: 'Brief history',    values: ['30 days', '1 year', '3 years', 'Unlimited'] },
  { label: 'Ask the Record',   values: ['10 q/day', '30 q/day', '100 q/day', '300 q/day'] },
  { label: 'Team seats',       values: ['1', '1', '5', '25'] },
  { label: 'Markets included',  values: ['1', '1', '1', 'All'] },
  { label: 'Additional markets', values: ['+$49/mo', '+$49/mo', '+$99/mo', 'Included'] },
  { label: 'SLA',              values: ['—', '—', '99.5%', '99.9%'] },
  { label: 'API access',       values: ['—', '—', '—', '✓'] },
];

const faqs = [
  {
    q: 'How does regional pricing work?',
    a: 'Each plan includes one market of your choice — Texas, California, or PJM. Additional markets are +$49/mo (Starter/Pro) or +$99/mo (Team), added in-app after signup. Org includes all markets. California is now live; PJM is free during its Beta period.',
  },
  {
    q: 'Is there a free trial?',
    a: '14 days free on the Pro plan with one region of your choice. No credit card required to start. PJM is free during its Beta period — no trial limit, just free.',
  },
  {
    q: 'Is PJM free during Beta?',
    a: 'Yes. PJM is free during its Beta period — no credit card required. At general availability, PJM access is +$49/mo (Starter/Pro) or +$99/mo (Team) added to an existing plan. We will notify you before any charge applies.',
  },
  {
    q: 'Can I cancel anytime?',
    a: 'Yes. Subscriptions are billed monthly and cancel at any time from your account settings. Cancellation takes effect at the end of the current billing period. No cancellation fees.',
  },
];
---

<Base
  title="Pricing — NodalPulse"
  description="NodalPulse pricing: Starter $99/mo, Pro $249/mo, Team $749/mo, Org $1,999/mo. 1 market included, additional markets +$49/mo. PJM free during Beta. 14-day free trial, no card required."
  extraSchema={[{
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }]}
>

  <section class="section">
    <div class="container">

      <div class="pricing-header">
        <h1 class="page-title">Pricing built for how professionals actually work.</h1>
        <p class="page-sub">
          Choose the level of coverage and capability that matches your regulatory monitoring needs. Every plan includes direct access to primary sources and structured, cited intelligence.
        </p>
        <p class="pricing-intro">
          Built for regulatory counsel, capacity traders, interconnection teams, and market professionals who need reliable, actionable intelligence — not another inbox full of links. Plans scale with the dockets you track, depth of history, team seats, and enterprise needs.
        </p>
      </div>

      <!-- ── Region toggle (CSS-only) ── -->
      <!-- All three panels are in HTML — AI crawlers see all prices -->
      <div class="region-toggle">
        <input type="radio" name="pricing-region" id="price-tx"  class="region-radio" checked>
        <input type="radio" name="pricing-region" id="price-ca"  class="region-radio">
        <input type="radio" name="pricing-region" id="price-pjm" class="region-radio">

        <div class="region-tab-bar">
          <label for="price-tx"  class="region-tab-label">Texas  <span class="tab-chip tab-chip--live">Live</span></label>
          <label for="price-ca"  class="region-tab-label">California <span class="tab-chip tab-chip--live">Live</span></label>
          <label for="price-pjm" class="region-tab-label">PJM <span class="tab-chip tab-chip--free">Free during Beta</span></label>
        </div>

        <div class="region-panels">

          <!-- Texas panel — normal pricing -->
          <div class="region-panel" id="price-panel-tx">
            <div class="tier-cards">
              {tiers.map(tier => (
                <div class:list={['tier-card', { 'tier-card--highlight': tier.highlight }]}>
                  {tier.highlight && <div class="tier-badge">Most popular</div>}
                  <div class="tier-name">{tier.name}</div>
                  <p class="tier-tagline">{tier.tagline}</p>
                  <div class="tier-price">
                    <span class="tier-amount">{tier.price}</span>
                    {tier.period && <span class="tier-period">{tier.period}</span>}
                  </div>
                  <ul class="tier-features">
                    {tier.features.map(f => <li>{f}</li>)}
                  </ul>
                  <a
                    href={tier.contactOnly ? 'mailto:hello@nodalpulse.com' : `https://app.nodalpulse.com/login?callbackURL=%2Fpricing%3Ftier%3D${tier.name.toLowerCase()}`}
                    class:list={[tier.highlight ? 'btn-primary' : 'btn-secondary', 'tier-cta']}
                  >
                    {tier.contactOnly ? 'Contact us' : 'Start free trial'}
                  </a>
                </div>
              ))}
            </div>
            <div class="addon-note">
              <span class="addon-icon" aria-hidden="true">+</span>
              <span>
                Additional markets: <strong>+$49/mo</strong> (Starter &amp; Pro) · <strong>+$99/mo</strong> (Team) · <strong>Included</strong> (Org).
                California live · PJM free during Beta.
                Added in-app after signup.
              </span>
            </div>
          </div>

          <!-- California panel — GA live (+$49/mo add-on) -->
          <div class="region-panel" id="price-panel-ca">
            <div class="tier-cards">
              {tiers.map(tier => (
                <div class:list={['tier-card', { 'tier-card--highlight': tier.highlight }]}>
                  {tier.highlight && <div class="tier-badge">Most popular</div>}
                  <div class="tier-name">{tier.name}</div>
                  <p class="tier-tagline">{tier.tagline}</p>
                  <div class="tier-price">
                    <span class="tier-amount">{tier.price}</span>
                    {tier.period && <span class="tier-period">{tier.period}</span>}
                  </div>
                  <ul class="tier-features">
                    {tier.features.map(f => <li>{f}</li>)}
                  </ul>
                  <a
                    href={tier.contactOnly ? 'mailto:hello@nodalpulse.com' : `https://app.nodalpulse.com/login?callbackURL=%2Fpricing%3Ftier%3D${tier.name.toLowerCase()}`}
                    class:list={[tier.highlight ? 'btn-primary' : 'btn-secondary', 'tier-cta']}
                  >
                    {tier.contactOnly ? 'Contact us' : 'Start free trial'}
                  </a>
                </div>
              ))}
            </div>
            <div class="addon-note">
              <span class="addon-icon" aria-hidden="true">+</span>
              <span>
                Additional markets: <strong>+$49/mo</strong> (Starter &amp; Pro) · <strong>+$99/mo</strong> (Team) · <strong>Included</strong> (Org).
                Texas live · PJM free during Beta.
                Added in-app after signup.
              </span>
            </div>
          </div>

          <!-- PJM panel — Beta free (struck prices) -->
          <div class="region-panel" id="price-panel-pjm">
            <div class="beta-region-notice">
              <span class="beta-free-badge-lg">Free during Beta</span>
              <span class="beta-region-note">No card required. $249/mo at general availability — we'll give you notice before any charge applies.</span>
            </div>
            <div class="tier-cards">
              {tiers.map(tier => (
                <div class:list={['tier-card', { 'tier-card--highlight': tier.highlight }]}>
                  {tier.highlight && <div class="tier-badge">Most popular</div>}
                  <div class="tier-name">{tier.name}</div>
                  <p class="tier-tagline">{tier.tagline}</p>

                  {tier.contactOnly ? (
                    <div class="tier-price">
                      <span class="tier-amount">{tier.price}</span>
                      <span class="tier-period">{tier.period}</span>
                    </div>
                  ) : (
                    <div class="tier-price-beta">
                      <span class="beta-free-chip">Free during Beta</span>
                      <div class="tier-price-struck">
                        <del><span class="tier-amount-muted">{tier.price}</span><span class="tier-period-muted">{tier.period} at GA</span></del>
                      </div>
                    </div>
                  )}

                  <ul class="tier-features">
                    {tier.features.map(f => <li>{f}</li>)}
                  </ul>
                  <a
                    href={tier.contactOnly ? 'mailto:hello@nodalpulse.com' : 'https://app.nodalpulse.com/login'}
                    class:list={[tier.highlight ? 'btn-primary' : 'btn-secondary', 'tier-cta']}
                  >
                    {tier.contactOnly ? 'Contact us' : 'Try free during Beta'}
                  </a>
                </div>
              ))}
            </div>
            <p class="ga-disclosure">
              At general availability, PJM access is <strong>$249/mo</strong> (Pro) or <strong>+$49/mo</strong> added to an existing Texas plan. We'll notify you before any charge applies.
            </p>
          </div>

        </div><!-- /region-panels -->
      </div><!-- /region-toggle -->

      <!-- Comparison table (tier features — region-agnostic) -->
      <div class="table-wrapper">
        <table class="compare-table">
          <thead>
            <tr>
              <th class="row-label-header">Feature</th>
              {tiers.map(tier => (
                <th class:list={['col-header', { 'col-header--highlight': tier.highlight }]}>
                  {tier.name}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map(row => (
              <tr>
                <td class="row-label">{row.label}</td>
                {row.values.map((val, i) => (
                  <td class:list={['row-val', { 'row-val--highlight': tiers[i].highlight, 'row-val--empty': val === '—' }]}>
                    {val}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Plan descriptions — help users self-select the right tier -->
      <div class="plan-desc-section">
        <h2 class="plan-desc-heading">Which plan fits you</h2>
        <div class="plan-desc-grid">
          {tiers.map(tier => (
            <div class:list={['plan-desc-card', { 'plan-desc-card--highlight': tier.highlight }]}>
              <div class="plan-desc-top">
                <span class="plan-desc-name">{tier.name}</span>
                {tier.highlight && <span class="plan-desc-badge">Most popular</span>}
              </div>
              <p class="plan-desc-body">{tier.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Why professionals choose NodalPulse -->
      <div class="why-pro-section">
        <h2 class="why-pro-heading">Why professionals choose NodalPulse</h2>
        <ul class="why-pro-list">
          <li>Direct ingestion from primary regulatory sources</li>
          <li>Structured extraction with verifiable citations</li>
          <li>Cross-jurisdictional threading across FERC, the ISOs, and state commissions</li>
          <li>Reliable daily delivery at 6:00&nbsp;AM&nbsp;CT</li>
          <li>Transparent methodology built for professional use</li>
        </ul>
        <a href="/methodology/" class="why-pro-link">See how we build trust in every brief →</a>
      </div>

      <!-- FAQ -->
      <div class="faq-section">
        <h2 class="faq-heading">Frequently asked questions</h2>
        <div class="faq-list">
          {faqs.map(faq => (
            <details class="faq-item">
              <summary class="faq-question">{faq.q}</summary>
              <div class="faq-answer">{faq.a}</div>
            </details>
          ))}
        </div>
        <p class="faq-more">More questions? <a href="/help/faq/">Help Center &rarr;</a></p>
      </div>

      <!-- Final CTA -->
      <div class="pricing-final">
        <h2 class="pricing-final-heading">Ready to operate with greater clarity?</h2>
        <p class="pricing-final-sub">
          Start with the plan that fits your needs today — you can upgrade as your coverage grows.
        </p>
        <a href="https://app.nodalpulse.com/login" class="btn-primary btn-lg pricing-final-cta">
          Start your free trial &rarr;
        </a>
        <p class="pricing-cta-note">14-day free trial · No card required · Cancel anytime. PJM free during Beta.</p>
      </div>

    </div>
  </section>

</Base>

<style>
  .pricing-header { text-align: center; margin-bottom: 32px; }

  .page-title {
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--np-text-primary);
    margin-bottom: 10px;
  }

  .page-sub { font-size: 16px; color: var(--np-text-muted); max-width: 540px; margin: 0 auto; line-height: 1.6; }

  .pricing-intro {
    max-width: 640px;
    margin: 16px auto 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--np-text-muted);
    text-align: center;
  }

  /* ── Region toggle (CSS-only) ── */
  .region-radio { position: absolute; opacity: 0; pointer-events: none; width: 0; height: 0; }

  .region-tab-bar {
    display: flex;
    gap: 4px;
    border-bottom: 1px solid var(--np-border);
    margin-bottom: 0;
  }

  .region-tab-label {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 500;
    color: var(--np-text-muted);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color 0.12s, border-color 0.12s;
    user-select: none;
  }

  .region-tab-label:hover { color: var(--np-text-primary); }

  .tab-chip {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 3px;
    letter-spacing: 0.03em;
  }

  .tab-chip--live { background: #D1FAE5; color: #065F46; }
  .tab-chip--free { background: #D1FAE5; color: #065F46; }

  /* Active tab via CSS sibling selectors */
  #price-tx:checked  ~ .region-tab-bar label[for="price-tx"],
  #price-ca:checked  ~ .region-tab-bar label[for="price-ca"],
  #price-pjm:checked ~ .region-tab-bar label[for="price-pjm"] {
    color: var(--np-text-primary);
    border-bottom-color: var(--np-accent);
  }

  /* Hide all panels by default */
  .region-panel { display: none; padding-top: 24px; }

  /* Show the checked panel */
  #price-tx:checked  ~ .region-panels #price-panel-tx  { display: block; }
  #price-ca:checked  ~ .region-panels #price-panel-ca  { display: block; }
  #price-pjm:checked ~ .region-panels #price-panel-pjm { display: block; }

  /* Beta notice bar */
  .beta-region-notice {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .beta-free-badge-lg {
    display: inline-block;
    background: #D1FAE5;
    color: #065F46;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 4px;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .beta-region-note { font-size: 13px; color: var(--np-text-muted); }

  /* Tier cards */
  .tier-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--np-border);
    border: 1px solid var(--np-border);
    border-radius: var(--np-radius-lg);
    overflow: hidden;
    margin-bottom: 0;
  }

  .tier-card {
    background: var(--np-surface);
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
  }

  .tier-card--highlight { background: var(--np-indigo-50); }

  .tier-badge {
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--np-indigo-600);
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 0 0 var(--np-radius-sm) var(--np-radius-sm);
  }

  .tier-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--np-text-strong);
    letter-spacing: 0.02em;
    margin-top: 10px;
  }

  .tier-tagline {
    font-size: 12px;
    color: var(--np-text-muted);
    line-height: 1.4;
    min-height: 34px;
  }

  .tier-features {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 2px 0 2px;
  }

  .tier-features li {
    position: relative;
    padding-left: 20px;
    font-size: 12.5px;
    color: var(--np-text-body);
    line-height: 1.45;
  }

  .tier-features li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 4px;
    width: 9px;
    height: 5px;
    border-left: 1.5px solid var(--np-indigo-600);
    border-bottom: 1.5px solid var(--np-indigo-600);
    transform: rotate(-45deg);
  }

  /* Normal price (Texas + Org) */
  .tier-price { display: flex; align-items: baseline; gap: 3px; }
  .tier-amount { font-size: 24px; font-weight: 600; color: var(--np-text-primary); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .tier-period { font-size: 13px; color: var(--np-text-muted); }

  /* Beta free (CA + PJM) */
  .tier-price-beta { display: flex; flex-direction: column; gap: 4px; }

  .beta-free-chip {
    display: inline-block;
    background: #D1FAE5;
    color: #065F46;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 3px;
    letter-spacing: 0.04em;
    align-self: flex-start;
  }

  .tier-price-struck { display: flex; align-items: baseline; }

  .tier-price-struck del {
    display: flex;
    align-items: baseline;
    gap: 2px;
    text-decoration: line-through;
    text-decoration-color: var(--np-text-muted);
  }

  .tier-amount-muted { font-size: 20px; font-weight: 500; color: var(--np-text-muted); font-variant-numeric: tabular-nums; }
  .tier-period-muted { font-size: 12px; color: var(--np-text-muted); }

  .tier-cta {
    width: 100%;
    justify-content: center;
    font-size: 13px;
    padding: 8px 12px;
    text-align: center;
    display: block;
    margin-top: auto;
  }

  /* GA disclosure */
  .ga-disclosure {
    font-size: 13px;
    color: var(--np-text-muted);
    line-height: 1.7;
    padding: 12px 16px;
    background: var(--np-surface-elevated);
    border: 1px solid var(--np-border);
    border-top: none;
    border-radius: 0 0 var(--np-radius-lg) var(--np-radius-lg);
    margin-top: 0;
  }

  /* Add-on note (Texas panel) */
  .addon-note {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 13px;
    color: var(--np-text-muted);
    background: var(--np-surface-elevated);
    border: 1px solid var(--np-border);
    border-top: none;
    border-radius: 0 0 var(--np-radius-lg) var(--np-radius-lg);
    padding: 12px 16px;
    line-height: 1.6;
  }

  .addon-icon { font-size: 15px; font-weight: 700; color: var(--np-accent); flex-shrink: 0; margin-top: 1px; }

  /* Comparison table */
  .table-wrapper {
    overflow-x: auto;
    margin: 32px 0 56px;
    border: 1px solid var(--np-border);
    border-radius: var(--np-radius-lg);
  }

  .compare-table { width: 100%; border-collapse: collapse; font-size: 13px; }

  .compare-table thead tr {
    background: var(--np-surface-elevated);
    border-bottom: 1px solid var(--np-border-strong);
  }

  .row-label-header {
    text-align: left;
    padding: 12px 20px;
    font-weight: 600;
    color: var(--np-text-strong);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    width: 200px;
  }

  .col-header {
    text-align: center;
    padding: 12px 16px;
    font-weight: 600;
    color: var(--np-text-strong);
    font-size: 13px;
    border-left: 1px solid var(--np-border);
  }

  .col-header--highlight { background: var(--np-indigo-50); color: var(--np-indigo-700); }

  .compare-table tbody tr { border-bottom: 1px solid var(--np-border); }
  .compare-table tbody tr:last-child { border-bottom: none; }
  .compare-table tbody tr:hover { background: var(--np-surface-elevated); }

  .row-label { padding: 12px 20px; color: var(--np-text-body); font-weight: 500; }

  .row-val {
    text-align: center;
    padding: 12px 16px;
    color: var(--np-text-primary);
    border-left: 1px solid var(--np-border);
    font-variant-numeric: tabular-nums;
  }

  .row-val--highlight { background: color-mix(in srgb, var(--np-indigo-50) 40%, transparent); }
  .row-val--empty { color: var(--np-text-muted); }

  /* FAQ */
  .faq-section { max-width: 680px; margin: 0 auto 56px; }

  .faq-heading { font-size: 20px; font-weight: 600; color: var(--np-text-primary); letter-spacing: -0.01em; margin-bottom: 24px; }

  .faq-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--np-border);
    border-radius: var(--np-radius-lg);
    overflow: hidden;
  }

  .faq-item { border-bottom: 1px solid var(--np-border); }
  .faq-item:last-child { border-bottom: none; }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    font-size: 14px;
    font-weight: 500;
    color: var(--np-text-primary);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker { display: none; }
  .faq-question::after { content: '+'; font-size: 18px; font-weight: 400; color: var(--np-text-muted); flex-shrink: 0; margin-left: 16px; }
  details[open] .faq-question::after { content: '−'; }
