---
import Base from '../layouts/Base.astro';

// Comparison rows. Competitor facts are drawn from each vendor's public website
// (as of July 2026) and kept to verifiable claims only. "—" = not publicly
// documented on the vendor's site; not an assertion of absence.
const cols = ['NodalPulse', 'Halcyon', 'EnerKnol', 'HData'];

const rows = [
  {
    label: 'Pricing',
    cells: [
      'Public — $99–$749/mo, self-serve (Org $1,999, contact)',
      'Free search; paid data products = contact sales',
      'Not public — "call for best pricing"',
      'Not public — contact sales',
    ],
  },
  {
    label: 'Start without a sales call',
    cells: [
      'Yes — 14-day trial, no card',
      'Free tier yes · paid data no',
      'Free trial (length not stated)',
      'No — demo-gated',
    ],
  },
  {
    label: 'Primary focus',
    cells: [
      'US power markets: ERCOT, CAISO, PJM + FERC layer',
      'Energy data platform (broad; data-center tilt)',
      'Broad energy + legislative (US + intl)',
      'FERC / EIA regulatory & financial data',
    ],
  },
  {
    label: 'Cross-jurisdiction docket threading',
    cells: [
      'Yes — ERCOT ↔ PUCT ↔ FERC ↔ PJM',
      '—',
      '—',
      '—',
    ],
  },
  {
    label: 'Cited extraction (claim → source)',
    cells: [
      'Yes — cited or dropped',
      'AI search with citations',
      'EKAI assistant (cited)',
      'Citations on AI answers',
    ],
  },
  {
    label: 'Delivery',
    cells: [
      'Daily cited brief + Ask the Record',
      'Editorial digest + agentic alerts',
      'Alerts + analyst research',
      'Alerts + analytics dashboards',
    ],
  },
];

const faqItems = [
  {
    q: 'What is the best Halcyon alternative for US power markets?',
    a: "If you want transparent pricing and a self-serve start focused specifically on US power markets (ERCOT, CAISO, PJM and the FERC layer), NodalPulse is a direct alternative: it publishes its plans ($99–$749/mo, plus a contact-based Org tier) and offers a 14-day free trial with no card and no sales call. Halcyon is a strong, well-funded platform with free AI search and asset-level data trackers, but its paid data subscriptions are quoted through sales rather than listed publicly."
  },
  {
    q: 'Does EnerKnol publish its pricing?',
    a: "Not publicly, as of July 2026. EnerKnol's site directs prospects to call for pricing or book a demo, with an optional self-serve module purchase whose prices appear only inside the checkout/account flow. It offers a free trial (length not stated on the public site). NodalPulse, by contrast, lists its per-tier prices openly and lets you self-checkout."
  },
  {
    q: 'What is the difference between NodalPulse and HData?',
    a: "HData is an AI-native platform centered on structured FERC and EIA data — financial benchmarking, analytics, and document search — sold through a demo-gated, contact-sales motion with no public pricing or free trial. NodalPulse is focused on the day-to-day regulatory record across US power markets (dockets, deadlines, party positions, cross-jurisdiction threading), with public pricing and a self-serve 14-day trial. Different centers of gravity: HData leans financial/analytics; NodalPulse leans regulatory workflow."
  },
  {
    q: 'Which regulatory intelligence tool is best for tracking ERCOT and PJM?',
    a: "For teams whose work centers on US ISO/RTO power markets — ERCOT, CAISO, PJM — and the FERC dockets that thread into them, NodalPulse is purpose-built: per-docket Record pages, extracted deadlines, and cross-jurisdiction threading, with pricing you can see and a trial you can start today. Halcyon, EnerKnol and HData are broader energy-data platforms; the best fit depends on whether you need that breadth or focused power-market depth with transparent, self-serve access."
  }
];
---

<Base
  title="NodalPulse vs Halcyon, EnerKnol & HData — Regulatory Intelligence Compared | NodalPulse"
  description="An honest comparison of US energy regulatory-intelligence tools: NodalPulse vs Halcyon, EnerKnol and HData. Pricing transparency, self-serve access, coverage, and cross-jurisdiction threading — verified from each vendor's public site."
  extraSchema={[{
    "@type": "FAQPage",
    "mainEntity": faqItems.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }]}
>

  <!-- ── Hero ── claim-first lead answer for GEO/AI citation -->
  <section class="hero section">
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-headline">
          NodalPulse vs Halcyon, EnerKnol &amp; HData.
        </h1>
        <p class="hero-lead">
          All four track US energy regulatory filings. The clearest difference: <strong>only NodalPulse publishes its pricing and lets you start on a self-serve 14-day trial — no sales call.</strong> Halcyon, EnerKnol and HData all quote their paid tiers through sales rather than list them. Here's an honest comparison for US power-market teams.
        </p>
        <div class="hero-actions">
          <a href="https://app.nodalpulse.com/login" class="btn-primary btn-lg">Start free trial →</a>
          <a href="/pricing/" class="btn-secondary btn-lg">See our pricing →</a>
        </div>
        <p class="hero-trust">14-day free trial · No card required · Cancel anytime</p>
      </div>
    </div>
  </section>

  <!-- ── Comparison table ── -->
  <section class="section bordered-top">
    <div class="container">
      <h2 class="section-heading">Side by side</h2>
      <div class="table-scroll">
        <table class="cmp-table">
          <thead>
            <tr>
              <th class="cmp-rowhead" scope="col"><span class="sr-only">Feature</span></th>
              {cols.map((c, i) => (
                <th scope="col" class:list={['cmp-col', { 'cmp-col--us': i === 0 }]}>{c}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map(row => (
              <tr>
                <th scope="row" class="cmp-rowhead">{row.label}</th>
                {row.cells.map((cell, i) => (
                  <td class:list={['cmp-cell', { 'cmp-cell--us': i === 0 }]}>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="cmp-note">
        Competitor details are drawn from each vendor's public website as of July&nbsp;2026 and limited to verifiable claims. "—" means the capability isn't publicly documented on that vendor's site — not that it's necessarily absent. Halcyon, EnerKnol and HData are established, capable products; this page is meant to help you choose, not to disparage them.
      </p>
    </div>
  </section>

  <!-- ── The honest differences ── -->
  <section class="section stakes-section">
    <div class="container">
      <h2 class="section-heading">The honest differences</h2>
      <div class="diff-grid">
        <div class="diff-card diff-card--us">
          <h3 class="diff-name">Where NodalPulse wins</h3>
          <ul class="diff-list">
            <li><strong>Transparent, self-serve pricing.</strong> Plans are public and you can start a 14-day trial with no card and no sales call — the only tool of the four to do so.</li>
            <li><strong>Power-market focus + threading.</strong> Built for ERCOT, CAISO, PJM and the FERC layer, with one living Record page per docket that threads a matter across jurisdictions.</li>
            <li><strong>Cited or dropped.</strong> Every claim links to the filing it came from; unsourced claims are dropped before delivery.</li>
          </ul>
        </div>
        <div class="diff-card">
          <h3 class="diff-name">Where the others are strong</h3>
          <ul class="diff-list">
            <li><strong>Halcyon</strong> — free AI search and asset-level data trackers (BESS, gas plants, rate cases, large-load tariffs), well-funded, broad energy corpus.</li>
            <li><strong>EnerKnol</strong> — very wide sweep: federal, ISOs/RTOs, all-state PUCs <em>and</em> legislatures, plus in-house analyst research.</li>
            <li><strong>HData</strong> — deep structured FERC/EIA financial data, benchmarking and analytics, with enterprise security and citations.</li>
          </ul>
        </div>
      </div>
      <p class="diff-foot">
        Breadth vs. depth is the real trade-off. If you need every energy sector and legislature, the broad platforms fit. If your work centers on US power-market dockets — and you want to see the price and start today — that's the gap NodalPulse fills.
      </p>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section-sm bordered-top">
    <div class="container">
      <div class="faq-block">
        <h2 class="faq-heading">Comparison questions</h2>
        <div class="faq-list">
          {faqItems.map(item => (
            <details class="faq-item">
              <summary class="faq-question">{item.q}</summary>
              <div class="faq-answer">{item.a}</div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <section class="cta-final section-sm">
    <div class="container">
      <div class="cta-inner">
        <h2 class="cta-heading">See the price. Start today.</h2>
        <p class="cta-sub">Public pricing, self-serve trial, no sales call. Texas &amp; California live · PJM in Beta.</p>
        <div class="cta-actions">
          <a href="https://app.nodalpulse.com/login" class="btn-primary btn-lg">Start free trial →</a>
          <a href="/pricing/" class="btn-secondary btn-lg">See pricing →</a>
        </div>
      </div>
    </div>
  </section>

</Base>

<style>
  .hero { border-bottom: 1px solid var(--np-border); }
  .hero-content { max-width: 760px; }
  .hero-headline {
    font-size: clamp(26px, 3.5vw, 40px);
    font-weight: 600; letter-spacing: -0.03em; line-height: 1.2;
    color: var(--np-text-primary); margin-bottom: 18px;
  }
  .hero-lead { font-size: 16px; color: var(--np-text-body); line-height: 1.7; max-width: 700px; margin-bottom: 28px; }
  .hero-lead strong { color: var(--np-text-primary); font-weight: 600; }
  .hero-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
  .btn-lg { padding: 11px 22px; font-size: 15px; }
  .hero-trust { font-size: 12px; color: var(--np-text-muted); }

  .section-heading {
    font-size: 24px; font-weight: 600; letter-spacing: -0.02em;
    color: var(--np-text-primary); margin-bottom: 24px; line-height: 1.25;
  }
  .bordered-top { border-top: 1px solid var(--np-border); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0; }

  /* Comparison table */
  .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; border: 1px solid var(--np-border); border-radius: var(--np-radius-lg); }
  .cmp-table { border-collapse: collapse; width: 100%; min-width: 720px; }
  .cmp-table th, .cmp-table td {
    text-align: left; vertical-align: top; padding: 14px 16px;
    border-bottom: 1px solid var(--np-border); font-size: 13px; line-height: 1.5;
  }
  .cmp-table thead th { border-bottom: 1px solid var(--np-border-strong); }
  .cmp-rowhead {
    font-size: 12px; font-weight: 600; color: var(--np-text-strong);
    background: var(--np-surface-elevated); white-space: nowrap;
    position: sticky; left: 0; z-index: 1; min-width: 180px;
  }
  .cmp-col { font-size: 14px; font-weight: 700; color: var(--np-text-primary); }
  .cmp-col--us { color: var(--np-indigo-700); }
  .cmp-cell { color: var(--np-text-body); }
  .cmp-cell--us { background: var(--np-indigo-50); color: var(--np-text-primary); font-weight: 500; }
  .cmp-table tbody tr:last-child th, .cmp-table tbody tr:last-child td { border-bottom: none; }
  .cmp-note { font-size: 12px; color: var(--np-text-muted); line-height: 1.6; margin-top: 16px; max-width: 820px; }

  /* Differences */
  .stakes-section { background: var(--np-surface-elevated); border-top: 1px solid var(--np-border); border-bottom: 1px solid var(--np-border); }
  .diff-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; }
  .diff-card {
    background: var(--np-surface); border: 1px solid var(--np-border);
    border-radius: var(--np-radius-lg); padding: 24px 22px;
  }
  .diff-card--us { border-color: var(--np-indigo-500); box-shadow: 0 1px 4px rgba(99,102,241,0.08), 0 4px 16px rgba(99,102,241,0.06); }
  .diff-name { font-size: 15px; font-weight: 600; color: var(--np-text-primary); margin-bottom: 14px; }
  .diff-list { display: flex; flex-direction: column; gap: 12px; }
  .diff-list li { font-size: 13.5px; color: var(--np-text-muted); line-height: 1.6; padding-left: 16px; position: relative; }
  .diff-list li::before { content: ''; position: absolute; left: 2px; top: 8px; width: 5px; height: 5px; border-radius: 50%; background: var(--np-indigo-500); }
  .diff-list strong { color: var(--np-text-primary); font-weight: 600; }
  .diff-foot { max-width: 760px; font-size: 15px; color: var(--np-text-primary); font-weight: 500; line-height: 1.6; }

  /* FAQ */
  .faq-block { max-width: 720px; }
  .faq-heading { font-size: 20px; font-weight: 600; color: var(--np-text-primary); margin-bottom: 20px; }
  .faq-list { border: 1px solid var(--np-border); border-radius: var(--np-radius-lg); overflow: hidden; }
  .faq-item { border-bottom: 1px solid var(--np-border); }
  .faq-item:last-child { border-bottom: none; }
  .faq-question {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 20px; font-size: 14px; font-weight: 500;
    color: var(--np-text-primary); cursor: pointer; list-style: none; user-select: none;
  }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-question::after { content: '+'; font-size: 18px; color: var(--np-text-muted); margin-left: 16px; flex-shrink: 0; }
  details[open] .faq-question::after { content: '−'; }
  .faq-question:hover { background: var(--np-surface-elevated); }
  .faq-answer { padding: 0 20px 16px; font-size: 14px; color: var(--np-text-muted); line-height: 1.7; }

  /* CTA */
  .cta-final { background: var(--np-indigo-50); border-top: 1px solid var(--np-border); }
  .cta-inner { max-width: 640px; margin: 0 auto; text-align: center; }
  .cta-heading { font-size: clamp(22px, 3vw, 28px); font-weight: 600; letter-spacing: -0.02em; color: var(--np-text-primary); margin-bottom: 10px; }
  .cta-sub { font-size: 15px; color: var(--np-text-muted); line-height: 1.6; margin-bottom: 24px; }
  .cta-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 768px) {
    .diff-grid { grid-template-columns: 1fr; }
  }
</style>
