---
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  // Pre-render the "today" and a sample ISO date slug.
  // Dynamic date slugs will be added when the pipeline populates real data.
  return [
    { params: { date: 'today' } },
    { params: { date: '2026-05-09' } },
  ];
}

const { date } = Astro.params;

// Normalise display date
function formatDisplayDate(raw: string | undefined): string {
  if (!raw || raw === 'today') {
    return new Date().toLocaleDateString('en-US', {
      weekday: 'long',
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'America/Chicago',
    });
  }
  // Expect ISO YYYY-MM-DD
  const parsed = new Date(raw + 'T12:00:00Z');
  if (isNaN(parsed.getTime())) return raw;
  return parsed.toLocaleDateString('en-US', {
    weekday: 'long',
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'America/Chicago',
  });
}

const isToday = !date || date === 'today';
const displayDate = formatDisplayDate(date);
const canonicalDate = isToday ? 'today' : date;

const pageTitle = isToday
  ? `Today's Public Digest — NodalPulse`
  : `Public Digest · ${displayDate} — NodalPulse`;

const pageDescription = isToday
  ? `NodalPulse public digest for ${displayDate}. PUCT filings, ERCOT protocol revisions, and FERC ERCOT-tagged actions — sourced and cited.`
  : `NodalPulse public digest for ${displayDate}. PUCT filings, ERCOT protocol revisions, and FERC ERCOT-tagged actions — sourced and cited.`;
---

<Base
  title={pageTitle}
  description={pageDescription}
  canonical={`https://nodalpulse.com/digest/${canonicalDate}`}
>

  <section class="section">
    <div class="container">

      <div class="digest-header">
        <div class="digest-meta">
          <span class="digest-label">Public Digest</span>
          <span class="digest-separator" aria-hidden="true">/</span>
          <span class="digest-date">{displayDate}</span>
        </div>
        <h1 class="digest-title">Today's ERCOT &amp; PUCT Regulatory Brief</h1>
      </div>

      <!-- Placeholder card -->
      <div class="placeholder-card">
        <div class="placeholder-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="10" stroke="#6366F1" stroke-width="1.5"/>
            <path d="M12 6V12L15.5 14.5" stroke="#6366F1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="placeholder-text">
          <h2 class="placeholder-heading">Today's public digest is generated nightly.</h2>
          <p class="placeholder-body">
            The public digest is assembled before 06:00&nbsp;CT each weekday and posted here by 07:00&nbsp;CT. Check back after that time for today's brief.
          </p>
          <p class="placeholder-body">
            The public digest includes a curated selection of the day's filings. Personalized briefs — filtered to your tracked markets, dockets, and keyword searches — are available on paid plans.
          </p>
        </div>

        <!-- Email capture -->
        <div class="email-capture" id="capture-idle">
          <p class="capture-label">Get the digest in your inbox — no card required.</p>
          <form class="capture-form" id="digest-subscribe-form" novalidate>
            <input
              type="email"
              name="email"
              placeholder="you@yourcompany.com"
              autocomplete="email"
              required
              class="capture-input"
              id="digest-email-input"
            />
            <button type="submit" class="btn-primary capture-btn" id="digest-submit-btn">
              Subscribe
            </button>
          </form>
          <p class="capture-error" id="capture-error" style="display:none"></p>
        </div>
        <div class="capture-success" id="capture-success" style="display:none">
          <span class="capture-success-icon" aria-hidden="true">✓</span>
          <span>You're subscribed. Check your inbox for a confirmation.</span>
        </div>

        <div class="placeholder-actions">
          <a href="https://app.nodalpulse.com/signup" class="btn-secondary">
            Get the personalized brief →
          </a>
        </div>
      </div>

      <script>
        (function () {
          const form = document.getElementById('digest-subscribe-form');
          const input = document.getElementById('digest-email-input');
          const btn = document.getElementById('digest-submit-btn');
          const errEl = document.getElementById('capture-error');
          const idleEl = document.getElementById('capture-idle');
          const successEl = document.getElementById('capture-success');

          if (!form) return;

          form.addEventListener('submit', async function (e) {
            e.preventDefault();
            const email = input.value.trim();
            if (!email) return;

            btn.disabled = true;
            btn.textContent = 'Subscribing…';
            errEl.style.display = 'none';

            try {
              const res = await fetch('https://app.nodalpulse.com/api/digest-subscribe', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email }),
              });
              if (res.ok) {
                idleEl.style.display = 'none';
                successEl.style.display = 'flex';
              } else {
                const data = await res.json().catch(() => ({}));
                errEl.textContent = data.error || 'Something went wrong. Try again.';
                errEl.style.display = 'block';
                btn.disabled = false;
                btn.textContent = 'Subscribe';
              }
            } catch {
              errEl.textContent = 'Network error. Please try again.';
              errEl.style.display = 'block';
              btn.disabled = false;
              btn.textContent = 'Subscribe';
            }
          });
        })();
      </script>

      <!-- SEO-structured content block for future population -->
      <!-- This section will be dynamically populated by the pipeline -->
      <div class="digest-content" aria-hidden="true" style="display:none;" id="digest-items">
        <!--
          Structured data placeholder for future population.
          When the pipeline runs, inject briefItems as JSON-LD here:

          <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "NewsArticle",
            "headline": "NodalPulse Public Digest · {date}",
            "datePublished": "{iso-date}",
            "publisher": { "@type": "Organization", "name": "NodalPulse" }
          }
          </script>
        -->
      </div>

      <!-- Navigation: previous/next date links (scaffold) -->
      <nav class="digest-nav" aria-label="Digest date navigation">
        <span class="digest-nav-link digest-nav-link--disabled">&larr; Previous brief</span>
        <a href="/digest/today" class="digest-nav-link">Latest digest &rarr;</a>
      </nav>

    </div>
  </section>

</Base>

<style>
  /* ── Header ── */
  .digest-header {
    margin-bottom: 36px;
  }

  .digest-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .digest-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--np-text-muted);
  }

  .digest-separator {
    color: var(--np-border-strong);
    font-size: 14px;
  }

  .digest-date {
    font-family: var(--np-font-mono);
    font-size: 12px;
    color: var(--np-text-muted);
  }

  .digest-title {
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--np-text-primary);
  }

  /* ── Placeholder card ── */
  .placeholder-card {
    max-width: 640px;
    border: 1px solid var(--np-border);
    border-radius: var(--np-radius-lg);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    background: var(--np-surface-elevated);
    margin-bottom: 48px;
  }

  .placeholder-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--np-indigo-50);
    border-radius: var(--np-radius-md);
  }

  .placeholder-text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .placeholder-heading {
    font-size: 16px;
    font-weight: 600;
    color: var(--np-text-primary);
  }

  .placeholder-body {
    font-size: 14px;
    color: var(--np-text-muted);
    line-height: 1.7;
  }

  .placeholder-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* ── Email capture ── */
  .email-capture { display: flex; flex-direction: column; gap: 10px; }

  .capture-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--np-text-body);
  }

  .capture-form {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .capture-input {
    flex: 1;
    min-width: 200px;
    padding: 9px 12px;
    font-size: 14px;
    border: 1px solid var(--np-border-strong);
    border-radius: var(--np-radius-sm);
    background: var(--np-surface);
    color: var(--np-text-primary);
    outline: none;
    transition: border-color 0.12s;
  }

  .capture-input::placeholder { color: var(--np-text-muted); }
  .capture-input:focus { border-color: var(--np-accent); }

  .capture-btn {
    white-space: nowrap;
    padding: 9px 18px;
    font-size: 13px;
  }

  .capture-error {
    font-size: 12px;
    color: #ef4444;
  }

  .capture-success {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: #10b981;
    font-weight: 500;
  }

  .capture-success-icon {
    font-size: 16px;
    font-weight: 700;
  }

  /* ── Digest nav ── */
  .digest-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 640px;
    padding-top: 20px;
    border-top: 1px solid var(--np-border);
  }

  .digest-nav-link {
    font-size: 13px;
    color: var(--np-indigo-600);
    text-decoration: none;
    font-weight: 500;
  }

  .digest-nav-link:hover {
    color: var(--np-indigo-700);
    text-decoration: underline;
  }

  .digest-nav-link--disabled {
    color: var(--np-text-muted);
    pointer-events: none;
    cursor: default;
  }
</style>
