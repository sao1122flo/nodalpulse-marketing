---
import Base from '../layouts/Base.astro';

const components = [
  { name: 'Brief delivery pipeline', status: 'Operational' },
  { name: 'PUCT crawler',            status: 'Operational' },
  { name: 'Web application',         status: 'Operational' },
];
---

<Base
  title="Service Status — NodalPulse"
  description="NodalPulse service status: real-time monitoring for the brief delivery pipeline, PUCT crawler, and web application."
>

  <section class="section">
    <div class="container">

      <div class="page-header">
        <h1 class="page-title">Service Status</h1>
        <p class="page-sub">
          Real-time status is monitored via Better Stack.
        </p>
        <a
          href="https://status.nodalpulse.com"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary status-link"
        >
          View live status &rarr;
        </a>
      </div>

      <!-- Component rows -->
      <div class="components-list">
        <div class="components-header">
          <span>Component</span>
          <span>Status</span>
        </div>
        {components.map(comp => (
          <div class="component-row">
            <span class="comp-name">{comp.name}</span>
            <div class="comp-status">
              <span class="status-dot" aria-hidden="true"></span>
              <span class="status-label">{comp.status}</span>
            </div>
          </div>
        ))}
      </div>

      <p class="status-note">
        For incidents and scheduled maintenance, see the <a href="https://status.nodalpulse.com" target="_blank" rel="noopener noreferrer" class="inline-link">live status page</a>. If you experience an issue not reflected here, contact <a href="mailto:support@nodalpulse.com" class="inline-link">support@nodalpulse.com</a>.
      </p>

    </div>
  </section>

</Base>

<style>
  .page-header {
    margin-bottom: 48px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 480px;
  }

  .page-title {
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--np-text-primary);
  }

  .page-sub {
    font-size: 15px;
    color: var(--np-text-muted);
  }

  .status-link {
    align-self: flex-start;
  }

  /* ── Component list ── */
  .components-list {
    max-width: 560px;
    border: 1px solid var(--np-border);
    border-radius: var(--np-radius-lg);
    overflow: hidden;
    margin-bottom: 32px;
  }

  .components-header {
    display: flex;
    justify-content: space-between;
    padding: 10px 20px;
    background: var(--np-surface-elevated);
    border-bottom: 1px solid var(--np-border-strong);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--np-text-muted);
  }

  .component-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--np-border);
  }

  .component-row:last-child {
    border-bottom: none;
  }

  .comp-name {
    font-size: 14px;
    font-weight: 500;
    color: var(--np-text-primary);
  }

  .comp-status {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22C55E;
    flex-shrink: 0;
  }

  .status-label {
    font-size: 13px;
    font-weight: 500;
    color: #166534;
  }

  /* ── Note ── */
  .status-note {
    font-size: 13px;
    color: var(--np-text-muted);
    max-width: 560px;
    line-height: 1.65;
  }

  .inline-link {
    color: var(--np-indigo-600);
    text-decoration: underline;
  }

  .inline-link:hover {
    color: var(--np-indigo-700);
  }
</style>
